# В git: код, правила, пресеты и решения режиссёра. Видео и всё, что пересобирается
# из них, остаётся на машине — это гигабайты.

# Данные клиентов — не в git движка (23.10.2026, Валера: «общий движок, клиентов отдельно, в этом и смысл»).
# Проекты (анкеты, правила, DESIGN.md, шрифты бренда) и решения роликов из work/ хранит свой репозиторий клиентов
# в .clients/ — scripts/clients.py, что именно — scripts/clients.gitignore. Видео — нигде: пересобираются из исходника.
/projects/*
!/projects/README.md
/work/
/.clients/
# страницы роликов пишет page.py из решений клиента; в движке — только общие вендоры и галереи
/studio/*
!/studio/_vendor/

# окружения python: .venv основное, .venv-audio отдельное под torch (вместе ~3,6 ГБ)
.venv*/
__pycache__/
*.pyc

# исходный вариативный шрифт: в репозитории нужен только запечённый ExtraBold
presets/fonts/Montserrat-var.ttf

# временный пресет, который пишет панель
presets/_ui.json

# личные настройки агентов на этой машине (общие — .claude/settings.json, .codex/hooks.json)
.claude/settings.local.json

# на Windows ссылки на скиллы — junction-папки: их содержимое не коммитить, это копия скилла
.claude/skills/*/

# новый конвейер: тяжёлое и пересобираемое не храним (большие модели качает scripts/models.py;
# маленькая модель лиц presets/models/ — в репозитории)
/models/
studio/*/assets/
studio/*/renders/
studio/*/snapshots/
studio/*/.hyperframes/
studio/*/node_modules/
# их заново пишет compose.py на каждой сборке
studio/*/camera.js
studio/*/captions.js
studio/*/edits.js
studio/*/layers.js
studio/*/fx.js
studio/*/hyperframes.json
studio/*/package.json

.DS_Store

# галерея приёмов fx — собирается scripts/fx_gallery.py из IMG_1799
studio/_fx_gallery/
studio/_bp_gallery/


# догруженные шрифты машины и шрифты проектов (scripts/fonts.py, 23.10.2026): лицензии заказчиков — мимо git движка
presets/fonts/local/
